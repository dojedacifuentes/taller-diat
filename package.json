{
  "name": "diat-prompting-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:class1": "node --test tests/class1.test.mjs",
    "test:class1:compiler": "node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/check-class1.mjs",
    "test": "npm run test:class1 && npm run test:class1:compiler",
    "vercel:build": "npm run test:class1 && npm run lint && next build",
    "build:class1-ppt": "node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/build-class1-deck.mjs && powershell -ExecutionPolicy Bypass -File scripts/class1/render-deck.ps1 && node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/audit-class1-deck.mjs",
    "build:class1-ppt:only": "node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/build-class1-deck.mjs",
    "render:class1-ppt": "powershell -ExecutionPolicy Bypass -File scripts/class1/render-deck.ps1",
    "audit:class1-ppt": "node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/audit-class1-deck.mjs",
    "build:class1-print": "node --experimental-strip-types --import ./scripts/class1/ts-resolve.mjs scripts/class1/build-printables.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jiti": "^2.6.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
