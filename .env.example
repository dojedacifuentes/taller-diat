# ─────────────────────────────────────────────────────────────────────────────
# Taller DIAT · variables de entorno
#
# Copia este archivo como `.env.local` para desarrollo, y configura las mismas
# variables en Vercel → Project Settings → Environment Variables para producción.
# Después de añadirlas hay que volver a desplegar: Vercel no las inyecta en un
# despliegue ya construido.
#
# Todas son server-side: ninguna lleva el prefijo NEXT_PUBLIC_ y por tanto
# ninguna llega al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Entrega de la Clase 1 por correo ────────────────────────────────────────
#
# Hay dos vías. Basta con configurar UNA; el servidor usa la primera que
# encuentre. Si no hay ninguna, el botón «Enviar Clase 1» lo dice y ofrece la
# entrega manual —descarga el archivo y abre el correo preparado—, que funciona
# siempre. Nunca se muestra un éxito falso.

# ── Vía 1 · SMTP ─────────────────────────────────────────────────────────────
# El camino natural en una universidad: el servidor de correo de la casa, o una
# cuenta de Gmail con «contraseña de aplicación» (no la contraseña normal).
#
#   Gmail:      smtp.gmail.com · puerto 587
#   Office 365: smtp.office365.com · puerto 587
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Solo si el servidor exige TLS desde el saludo (puerto 465). Con 587 se deja
# vacío: se negocia STARTTLS.
SMTP_SECURE=

# ── Vía 2 · Resend ───────────────────────────────────────────────────────────
# API HTTP, sin dependencias. Requiere verificar un dominio propio.
# https://resend.com → API Keys
RESEND_API_KEY=

# ─── Comunes a las dos vías ──────────────────────────────────────────────────

# Remitente. Con SMTP puede dejarse vacío: se usa SMTP_USER, que es lo que casi
# siempre acepta el servidor. Con Resend debe ser un dominio verificado.
# Ejemplo: DIAT PUCV <taller@tu-dominio.cl>
CLASS1_SUBMISSION_FROM=

# Destinatario de las entregas. Si se deja vacío se usa el del programa
# definido en src/content/class1/manifest.ts (programadiat@pucv.cl).
CLASS1_SUBMISSION_EMAIL=

# Copia opcional. Vacío = la copia del manifest (diego.ojeda.c@pucv.cl).
CLASS1_SUBMISSION_CC=
