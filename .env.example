# ─────────────────────────────────────────────────────────────────────────────
# Taller DIAT · variables de entorno
#
# Copia este archivo como `.env.local` para desarrollo, y configura las mismas
# variables en Vercel → Project Settings → Environment Variables para producción.
#
# Todas son server-side: ninguna lleva el prefijo NEXT_PUBLIC_ y por tanto
# ninguna llega al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Entrega de la Clase 1 por correo ────────────────────────────────────────
# Sin RESEND_API_KEY y CLASS1_SUBMISSION_FROM, el botón «Enviar Clase 1» informa
# honestamente de que el envío no está configurado y el estudiante entrega
# descargando el archivo. Nunca se muestra un éxito falso.

# Clave del proveedor de correo (https://resend.com → API Keys).
RESEND_API_KEY=

# Remitente. Debe ser una dirección de un dominio verificado en el proveedor.
# Ejemplo: DIAT PUCV <taller@tu-dominio-verificado.cl>
CLASS1_SUBMISSION_FROM=

# Destinatario de las entregas de la Clase 1.
# Si se deja vacío se usa el destinatario del programa definido en
# src/content/class1/manifest.ts (programadiat@pucv.cl).
CLASS1_SUBMISSION_EMAIL=

# Copia opcional. Si se deja vacío se usa la copia definida en el manifest
# (diego.ojeda.c@pucv.cl).
CLASS1_SUBMISSION_CC=
